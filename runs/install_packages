#!/usr/bin/env bash

set -euo pipefail

packages=(gdb git-delta curl neovim tree-sitter-cli tmux fzf ripgrep yt-dlp tree trash-cli)

case "$OSTYPE" in
    linux-gnu*)

        packages+=(zsh fd-find clang clangd nodejs npm ruby ruby-dev ruby-bundler build-essential libyaml-dev python3 ca-certificates)

        echo "updating apt package lists..."
        sudo apt-get update

        # TeX lecture notes: compilation, PDF viewing, and GNOME desktop control.
        packages+=(latexmk texlive-latex-recommended texlive-latex-extra texlive-fonts-recommended texlive-science)
        packages+=(zathura zathura-pdf-poppler python3-gi gir1.2-glib-2.0 libglib2.0-bin)
        # Ubuntu 26.04 bundles DING and Ubuntu Dock in one package; older releases
        # package them separately. Query after apt update for fresh installations.
        if apt-cache show gnome-shell-ubuntu-extensions >/dev/null 2>&1; then
            packages+=(gnome-shell-ubuntu-extensions)
        else
            packages+=(gnome-shell-extension-desktop-icons-ng gnome-shell-extension-ubuntu-dock)
        fi

        # Disable apport (Ubuntu crash reporting)
        if [[ -f /etc/default/apport ]]; then
            sudo sed -i 's/enabled=1/enabled=0/g' /etc/default/apport
        fi

        echo "installing packages..."
        sudo apt-get install -y --no-upgrade "${packages[@]}"
        ;;

    darwin*)

        packages+=(fd llvm node ruby python uv lua-language-server)

        if ! command -v brew &> /dev/null; then
            echo "Installing Homebrew..."
            NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        else
            echo "Homebrew already installed"
        fi

        brew update

        HOMEBREW_NO_INSTALL_UPGRADE=1 brew install "${packages[@]}"
        ;;

    *)
        printf 'Unsupported platform: %s\n' "$OSTYPE" >&2; exit 1 ;;
esac

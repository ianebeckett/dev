#!/usr/bin/env bash

set -eu

source "$HOME/dev/lib/links.sh"

# Link zsh configuration
link_config "$HOME/dev/env/.config/zsh" "$XDG_CONFIG_HOME/zsh"
link_config "$HOME/dev/env/.config/zsh/.zshenv" "$HOME/.zshenv"
link_config "$HOME/dev/env/.config/zsh/.zshrc" "$HOME/.zshrc"

# Zsh creates its own completion dump and history files.
mkdir -p "$XDG_CACHE_HOME/zsh" "$XDG_STATE_HOME/zsh"

#!/usr/bin/env bash

set -e

# Ensure XDG directories are set (also defined in .zshenv but needed here during setup)
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# Link zsh configuration
ln -sf "$HOME/dev/env/.config/zsh" "$HOME/.config/zsh"
ln -sf "$HOME/dev/env/.config/zsh/.zshrc" "$HOME/.zshrc"

# Zsh creates its own completion dump and history files.
mkdir -p "$XDG_CACHE_HOME/zsh" "$XDG_STATE_HOME/zsh"

#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "$0")/../env/.config/zsh/.zshenv"

case "$OSTYPE" in
    linux-gnu*|darwin*) ;;
    *) printf 'Unsupported platform: %s\n' "$OSTYPE" >&2; exit 1 ;;
esac

mkdir -p "$HOME/.local/bin"
download_dir="$(mktemp -d "${TMPDIR:-/tmp}/dev-language-servers.XXXXXX")"
trap 'rm -rf "$download_dir"' EXIT

if command -v uv >/dev/null 2>&1; then
    echo "uv already installed"
else
    echo "Installing uv..."
    curl -fLsS https://astral.sh/uv/install.sh -o "$download_dir/uv-install.sh"
    UV_INSTALL_DIR="$HOME/.local/bin" UV_NO_MODIFY_PATH=1 sh "$download_dir/uv-install.sh"
fi

if [[ "$OSTYPE" == linux-gnu* ]] && ! command -v lua-language-server >/dev/null 2>&1; then
    # Keep the full release together: the executable loads adjacent Lua files.
    lua_version="3.19.1"
    case "$(uname -m)" in
        x86_64)
            lua_arch="x64"
            lua_sha256="e9235d2d72ef55bc41cf8c99cda2ed64777682024b4bb81f5dea425060c5cbb8"
            ;;
        aarch64|arm64)
            lua_arch="arm64"
            lua_sha256="abd2572e8fc929dc838a81ffb8473c5bce0bf39bfe8edb4b120b3b623176ce83"
            ;;
        *) printf 'Unsupported LuaLS architecture: %s\n' "$(uname -m)" >&2; exit 1 ;;
    esac
    echo "Installing lua-language-server $lua_version..."
    curl -fLsS "https://github.com/LuaLS/lua-language-server/releases/download/$lua_version/lua-language-server-$lua_version-linux-$lua_arch.tar.gz" \
        -o "$download_dir/luals.tar.gz"
    printf '%s  %s\n' "$lua_sha256" "$download_dir/luals.tar.gz" | sha256sum --check --status
    mkdir "$download_dir/luals"
    tar -xzf "$download_dir/luals.tar.gz" -C "$download_dir/luals"
    # Validate before touching the destination so a failed download is retryable.
    "$download_dir/luals/bin/lua-language-server" --version
    mkdir -p "$HOME/.local/lua-language-server"
    cp -R "$download_dir/luals/." "$HOME/.local/lua-language-server/"
fi

# Pin npm packages so repeat runs do not select newer server releases.
npm install --global --prefix "$HOME/.local" vscode-langservers-extracted@4.10.0 quick-lint-js@3.2.0
gem install ruby-lsp --conservative --user-install --bindir "$HOME/.local/bin" --no-document
UV_TOOL_BIN_DIR="$HOME/.local/bin" uv tool install basedpyright

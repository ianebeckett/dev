#!/usr/bin/env bash

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd) || exit 1
dry=""

while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--dry-run" ]]; then
        dry="1"
    fi
    shift
done

log() {
    if [[ $dry == "1" ]]; then
        printf '[dry-run]: %s\n' "$*"
    else
        printf '%s\n' "$*"
    fi
}

execute() {
    log "execute $*"
    if [[ $dry == "1" ]]; then
        return 0
    fi

    if "$@"; then
        return 0
    else
        local status=$?
        printf 'Error: %s failed (exit status %s)\n' "$1" "$status" >&2
        exit "$status"
    fi
}

cd "$script_dir" || exit 1

# Initialize the environment before any run scripts use it.
source ./env/.config/zsh/.zshenv || exit 1

scripts=("agents" "codex" "neovim" "scripts" "tmux" "tmux-sessionizer" "zsh")
log "Running scripts from $script_dir/runs"
for script in "${scripts[@]}"; do
    # Match the previous discovery rule: executable regular files, not symlinks.
    if [[ ! -f "$script" || ! -x "$script" || -L "$script" ]]; then
        continue
    fi

    execute "$script"
done

#!/usr/bin/env bash

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
filter=""
dry=""

while [[ $# > 0 ]]; do
    if [[ "$1" == "--dry-run" ]]; then
        dry="1"
    else 
        filter="$1"
    fi
    shift
done

log() {
    if [[ $dry == "1" ]]; then
        echo "[dry-run]: $@"
    else 
        echo "$@"
    fi
}

execute() {
    log "execute $@"
    if [[ $dry == "1" ]]; then
        return
    fi

    "$@"
}

log "Running scripts from $script_dir/runs with filter: '$filter'"

cd "$script_dir"
scripts=$(find ./runs -maxdepth 1 -mindepth 1 -executable -type f)

for script in $scripts; do
    # If filter is provided, only run scripts that match
    if [[ -n "$filter" ]]; then
        if ! echo "$script" | grep -q "$filter"; then
            log "filtering out: $script"
            continue
        fi
    fi

    execute "$script"
done

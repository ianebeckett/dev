#!/usr/bin/env bash

while [[ $# -gt 0 ]]; do
    if [[ "$1" == "--dry-run" ]]; then
        dry="1"
    fi
    shift
done

execute() {
    if [[ $dry == "1" ]]; then
        return 0
    fi

    if "$@"; then
        return 0
    else
        local status=$?
        printf 'Error: %s failed (exit status %s)\n' "$1" "$status" >&2
        exit "$status"
    fi
}

# Initialize the environment before any run scripts use it.
source ./env/.config/zsh/.zshenv || exit 1

runs_dir='./runs/'

install_script="./runs/install_packages"
execute "$install_script"

echo "Linking and configuring tools..."
config_scripts=("agents" "codex" "neovim" "scripts" "tmux" "tmux-sessionizer" "zsh")

for script in "${config_scripts[@]}"; do
    # Match the previous discovery rule: executable regular files, not symlinks.
    if [[ ! -f "$script" || ! -x "$script" || -L "$script" ]]; then
        continue
    fi

    execute "$script"
done

#!/usr/bin/env bash

set -e

REPO_URL="https://github.com/ianebeckett/dev"
REPO_DIR="$HOME/dev"

# Detect OS
if [[ "$OSTYPE" == "darwin"* ]]; then
    OS="macos"
    PKG_MANAGER="brew"
    
    # Detect architecture
    if [[ $(uname -m) == "arm64" ]]; then
        HOMEBREW_PATH="/opt/homebrew/bin"
        ARCH="Apple Silicon"
    else
        HOMEBREW_PATH="/usr/local/bin"
        ARCH="Intel"
    fi
    
    echo "Detected OS: macOS ($ARCH)"
    
    # Install Homebrew if not present
    if ! command -v brew &> /dev/null; then
        echo "Installing Homebrew..."
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
        
        # Add Homebrew to PATH for this session
        export PATH="$HOMEBREW_PATH:$PATH"
    else
        echo "Homebrew already installed"
    fi
    
elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
    OS="linux"
    PKG_MANAGER="apt"
    echo "Detected OS: Linux"
    
    # Ensure sudo available
    sudo apt -y update
else
    echo "Error: Unsupported OS: $OSTYPE"
    exit 1
fi

# Install git if needed (for cloning)
if ! command -v git &> /dev/null; then
    echo "Installing git..."
    if [[ "$OS" == "macos" ]]; then
        brew install git
    else
        sudo apt-get install -y git
    fi
fi

# Clone repo if not already present
if [ ! -d "$REPO_DIR/.git" ]; then
    echo "Cloning dev repository to $REPO_DIR..."
    git clone "$REPO_URL" "$REPO_DIR"
    cd "$REPO_DIR"
else
    echo "Repository already exists at $REPO_DIR"
    cd "$REPO_DIR"
fi

# Update the repository to latest
echo "Updating repository..."
git pull

# Link gitconfig
ln -sf "$HOME/dev/env/.gitconfig" "$HOME/.gitconfig"

# Run the runner script to configure all tools
echo "Running configuration scripts..."
"$HOME/dev/runner"

echo "Setup complete!"
